include README.md LICENSE AGENTS.md Makefile hacs.json manifest.json
recursive-include src *.py *.json
recursive-include docs *.md
recursive-include examples *.yaml *.md .env.example
recursive-include .github/workflows *.yml
prune src/winix_local.egg-info
global-exclude __pycache__ *.py[cod] *.key *.pem
